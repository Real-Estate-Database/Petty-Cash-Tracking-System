classDiagram

    %% ========================================================
    %% SHARED PROJECT: ENUMERATIONS (Type-safe C# Enums)
    %% ========================================================
    class RoleType {
        <<enumeration>>
        SuperAdmin
        Custom
    }

    class AdvanceStatus {
        <<enumeration>>
        Draft
        Pending
        Approved
        Rejected
        FundsIssued
        PartiallyReconciled
        Reconciled
        Cancelled
    }

    class ExpenseStatus {
        <<enumeration>>
        PendingReview
        Approved
        Rejected
        Resubmitted
    }

    class ExpenseCategoryType {
        <<enumeration>>
        Fuel
        Meals
        Transport
        Accommodation
        Parking
        Miscellaneous
    }

    class ReimbursementStatus {
        <<enumeration>>
        Pending
        Approved
        Rejected
        Paid
    }

    class ReconciliationStatus {
        <<enumeration>>
        InProgress
        PendingSurplusReturn
        PendingDeficitPayout
        Settled
        Closed
    }

    class SettlementType {
        <<enumeration>>
        Balanced
        Surplus
        Shortfall
    }

    %% ========================================================
    %% SHARED PROJECT: DATA TRANSFER OBJECTS (DTOs)
    %% ========================================================
    class LoginRequestDto {
        +string Email
        +string Password
    }

    class LoginResponseDto {
        +string Token
        +DateTime Expiration
        +UserDto User
        +List~string~ Permissions
    }

    class UserDto {
        +int UserId
        +int RoleId
        +string RoleName
        +string FirstName
        +string LastName
        +string Email
        +bool IsActive
    }

    class CreateUserDto {
        +string FirstName
        +string LastName
        +string Email
        +string Password
        +int RoleId
    }

    class CreateAdvanceDto {
        +decimal RequestedAmount
        +string Purpose
        +string Destination
        +int? ParentAdvanceId
    }

    class AdvanceDetailDto {
        +int AdvanceId
        +int EmployeeId
        +string EmployeeName
        +decimal RequestedAmount
        +decimal ApprovedAmount
        +decimal IssuedAmount
        +string Purpose
        +AdvanceStatus Status
        +DateTime RequestedAt
        +List~ExpenseDto~ Expenses
    }

    class RecordExpenseDto {
        +int AdvanceId
        +int CategoryId
        +decimal Amount
        +DateTime ExpenseDate
        +string Destination
        +string Description
        +string FundingSource
    }

    class ExpenseDto {
        +int ExpenseId
        +int AdvanceId
        +string CategoryName
        +decimal Amount
        +ExpenseStatus Status
        +string ReceiptUrl
    }

    class ReconciliationSummaryDto {
        +int AdvanceId
        +decimal TotalIssued
        +decimal TotalSpent
        +decimal TotalReturned
        +decimal TotalReimbursed
        +decimal NetBalance
        +SettlementType Outcome
        +ReconciliationStatus Status
    }

    class ClaimReimbursementDto {
        +int? ExpenseId
        +decimal Amount
        +string Reason
    }

    %% ========================================================
    %% SHARED PROJECT: SERVICE INTERFACES (Contracts)
    %% ========================================================
    class IAuthService {
        <<interface>>
        +LoginAsync(LoginRequestDto dto) Task~LoginResponseDto~
        +LogoutAsync(string token) Task
        +GetCurrentUserAsync() Task~UserDto~
    }

    class IUserService {
        <<interface>>
        +CreateUserAsync(CreateUserDto dto) Task~UserDto~
        +UpdateUserAsync(int id, CreateUserDto dto) Task~UserDto~
        +ToggleUserStatusAsync(int id, bool isActive) Task
        +GetUsersAsync() Task~List~UserDto~~
    }

    class IPermissionService {
        <<interface>>
        +CreateRoleAsync(string name, string desc) Task
        +AssignPermissionsToRoleAsync(int roleId, List~int~ permissionIds) Task
        +GetUserPermissionsAsync(int userId) Task~List~string~~
        +HasPermissionAsync(int userId, string permissionCode) Task~bool~
    }

    class IAdvanceService {
        <<interface>>
        +SubmitAdvanceAsync(CreateAdvanceDto dto) Task~AdvanceDetailDto~
        +CancelAdvanceAsync(int advanceId, int userId) Task
        +ApproveAdvanceAsync(int advanceId, decimal approvedAmount) Task
        +RejectAdvanceAsync(int advanceId, string reason) Task
        +IssueFundsAsync(int advanceId, decimal amount) Task
        +GetAdvanceByIdAsync(int id) Task~AdvanceDetailDto~
        +GetAdvancesAsync() Task~List~AdvanceDetailDto~~
    }

    class IExpenseService {
        <<interface>>
        +RecordExpenseAsync(RecordExpenseDto dto) Task~ExpenseDto~
        +AttachReceiptAsync(int expenseId, Stream fileStream, string fileName) Task
        +ReviewExpenseAsync(int expenseId, bool approve, string reason) Task
        +GetExpensesByAdvanceIdAsync(int advanceId) Task~List~ExpenseDto~~
    }

    class IReconciliationService {
        <<interface>>
        +CalculateReconciliationAsync(int advanceId) Task~ReconciliationSummaryDto~
        +ConfirmSurplusReturnAsync(int advanceId, decimal amount) Task
        +FinalizeReconciliationAsync(int advanceId, int userId) Task
    }

    class IReimbursementService {
        <<interface>>
        +SubmitClaimAsync(ClaimReimbursementDto dto) Task
        +ApproveClaimAsync(int claimId, int approverId) Task
        +ProcessPayoutAsync(int claimId, decimal amount) Task
    }

    class IReportingService {
        <<interface>>
        +GetExecutiveSummaryAsync() Task
        +ExportExpensesToCsvAsync() Task
    }

    class IAuditService {
        <<interface>>
        +LogActivityAsync(int userId, string action, string entity, int entityId) Task
        +GetAuditTrailAsync() Task
    }

    class INotificationService {
        <<interface>>
        +SendNotificationAsync(string toEmail, string subject, string body) Task
    }

    %% ========================================================
    %% BACKEND SERVER PROJECT: DOMAIN ENTITIES (EF Core Models)
    %% ========================================================
    class User {
        +int UserId
        +int RoleId
        +string FirstName
        +string LastName
        +string Email
        +string PasswordHash
        +bool IsActive
        +DateTime CreatedAt
        +DateTime UpdatedAt
    }

    class Role {
        +int RoleId
        +string Name
        +string Description
        +bool IsSystemRole
        +bool IsActive
        +DateTime CreatedAt
    }

    class Permission {
        +int PermissionId
        +string Code
        +string Name
        +string Module
        +string Description
    }

    class RolePermission {
        +int RoleId
        +int PermissionId
        +DateTime AssignedAt
    }

    class AdvanceRequest {
        +int AdvanceId
        +int EmployeeId
        +int? ApprovedByUserId
        +int? IssuedByUserId
        +int? ParentAdvanceId
        +decimal RequestedAmount
        +decimal ApprovedAmount
        +decimal IssuedAmount
        +string Purpose
        +string Destination
        +AdvanceStatus Status
        +string RejectionReason
        +DateTime RequestedAt
        +DateTime? ApprovedAt
        +DateTime? IssuedAt
    }

    class Expense {
        +int ExpenseId
        +int AdvanceId
        +int EmployeeId
        +int CategoryId
        +int? ReviewedByUserId
        +decimal Amount
        +DateTime ExpenseDate
        +string Destination
        +string Description
        +string FundingSource
        +ExpenseStatus Status
        +string RejectionReason
        +DateTime SubmittedAt
        +DateTime? ReviewedAt
    }

    class ExpenseCategory {
        +int CategoryId
        +string Name
        +string Description
        +bool IsActive
    }

    class Receipt {
        +int ReceiptId
        +int ExpenseId
        +string FileName
        +string FilePath
        +string ContentType
        +long FileSize
        +DateTime UploadedAt
    }

    class ReimbursementClaim {
        +int ClaimId
        +int EmployeeId
        +int? ExpenseId
        +int? ApprovedByUserId
        +int? PaidByUserId
        +decimal Amount
        +string Reason
        +ReimbursementStatus Status
        +string RejectionReason
        +DateTime SubmittedAt
    }

    class Reconciliation {
        +int ReconciliationId
        +int AdvanceId
        +int ReconciledByUserId
        +decimal TotalIssued
        +decimal TotalSpent
        +decimal TotalReturned
        +decimal TotalReimbursed
        +decimal Balance
        +ReconciliationStatus Status
        +DateTime ReconciledAt
    }

    class CashReturn {
        +int CashReturnId
        +int ReconciliationId
        +decimal Amount
        +DateTime ReturnedAt
        +int ConfirmedByUserId
        +string Notes
    }

    class AuditLog {
        +long AuditLogId
        +int UserId
        +string Action
        +string EntityName
        +int EntityId
        +string OldValues
        +string NewValues
        +DateTime CreatedAt
    }

    class AppDbContext {
        +DbSet~User~ Users
        +DbSet~Role~ Roles
        +DbSet~Permission~ Permissions
        +DbSet~RolePermission~ RolePermissions
        +DbSet~AdvanceRequest~ AdvanceRequests
        +DbSet~Expense~ Expenses
        +DbSet~ExpenseCategory~ ExpenseCategories
        +DbSet~Receipt~ Receipts
        +DbSet~ReimbursementClaim~ ReimbursementClaims
        +DbSet~Reconciliation~ Reconciliations
        +DbSet~CashReturn~ CashReturns
        +DbSet~AuditLog~ AuditLogs
        +SaveChangesAsync() Task~int~
    }

    %% ========================================================
    %% BACKEND SERVER PROJECT: SERVICE IMPLEMENTATIONS
    %% ========================================================
    class AuthService {
        -AppDbContext _db
        +LoginAsync(LoginRequestDto dto) Task~LoginResponseDto~
        +LogoutAsync(string token) Task
        +GetCurrentUserAsync() Task~UserDto~
    }

    class UserService {
        -AppDbContext _db
        -IAuditService _audit
        +CreateUserAsync(CreateUserDto dto) Task~UserDto~
        +UpdateUserAsync(int id, CreateUserDto dto) Task~UserDto~
        +ToggleUserStatusAsync(int id, bool isActive) Task
        +GetUsersAsync() Task~List~UserDto~~
    }

    class PermissionService {
        -AppDbContext _db
        +CreateRoleAsync(string name, string desc) Task
        +AssignPermissionsToRoleAsync(int roleId, List~int~ permissionIds) Task
        +GetUserPermissionsAsync(int userId) Task~List~string~~
        +HasPermissionAsync(int userId, string permissionCode) Task~bool~
    }

    class AdvanceService {
        -AppDbContext _db
        -INotificationService _notifier
        -IAuditService _audit
        +SubmitAdvanceAsync(CreateAdvanceDto dto) Task~AdvanceDetailDto~
        +CancelAdvanceAsync(int advanceId, int userId) Task
        +ApproveAdvanceAsync(int advanceId, decimal approvedAmount) Task
        +RejectAdvanceAsync(int advanceId, string reason) Task
        +IssueFundsAsync(int advanceId, decimal amount) Task
        +GetAdvanceByIdAsync(int id) Task~AdvanceDetailDto~
        +GetAdvancesAsync() Task~List~AdvanceDetailDto~~
    }

    class ExpenseService {
        -AppDbContext _db
        -INotificationService _notifier
        -IAuditService _audit
        +RecordExpenseAsync(RecordExpenseDto dto) Task~ExpenseDto~
        +AttachReceiptAsync(int expenseId, Stream fileStream, string fileName) Task
        +ReviewExpenseAsync(int expenseId, bool approve, string reason) Task
        +GetExpensesByAdvanceIdAsync(int advanceId) Task~List~ExpenseDto~~
    }

    class ReconciliationService {
        -AppDbContext _db
        -IReimbursementService _reimbursement
        -IAuditService _audit
        +CalculateReconciliationAsync(int advanceId) Task~ReconciliationSummaryDto~
        +ConfirmSurplusReturnAsync(int advanceId, decimal amount) Task
        +FinalizeReconciliationAsync(int advanceId, int userId) Task
    }

    class ReimbursementService {
        -AppDbContext _db
        -INotificationService _notifier
        -IAuditService _audit
        +SubmitClaimAsync(ClaimReimbursementDto dto) Task
        +ApproveClaimAsync(int claimId, int approverId) Task
        +ProcessPayoutAsync(int claimId, decimal amount) Task
    }

    class ReportingService {
        -AppDbContext _db
        +GetExecutiveSummaryAsync() Task
        +ExportExpensesToCsvAsync() Task
    }

    class AuditService {
        -AppDbContext _db
        +LogActivityAsync(int userId, string action, string entity, int entityId) Task
        +GetAuditTrailAsync() Task
    }

    class NotificationService {
        -IEmailClient _emailClient
        +SendNotificationAsync(string toEmail, string subject, string body) Task
    }

    %% ========================================================
    %% RELATIONSHIPS & REALIZATIONS
    %% ========================================================
    %% Service Implementations Realizing Shared Interfaces
    AuthService ..|> IAuthService
    UserService ..|> IUserService
    PermissionService ..|> IPermissionService
    AdvanceService ..|> IAdvanceService
    ExpenseService ..|> IExpenseService
    ReconciliationService ..|> IReconciliationService
    ReimbursementService ..|> IReimbursementService
    ReportingService ..|> IReportingService
    AuditService ..|> IAuditService
    NotificationService ..|> INotificationService

    %% Service Dependencies on EF DbContext
    AuthService --> AppDbContext
    UserService --> AppDbContext
    PermissionService --> AppDbContext
    AdvanceService --> AppDbContext
    ExpenseService --> AppDbContext
    ReconciliationService --> AppDbContext
    ReimbursementService --> AppDbContext
    ReportingService --> AppDbContext
    AuditService --> AppDbContext

    %% EF Core DbContext to Entities
    AppDbContext "1" *-- "many" User
    AppDbContext "1" *-- "many" Role
    AppDbContext "1" *-- "many" Permission
    AppDbContext "1" *-- "many" RolePermission
    AppDbContext "1" *-- "many" AdvanceRequest
    AppDbContext "1" *-- "many" Expense
    AppDbContext "1" *-- "many" ExpenseCategory
    AppDbContext "1" *-- "many" Receipt
    AppDbContext "1" *-- "many" ReimbursementClaim
    AppDbContext "1" *-- "many" Reconciliation
    AppDbContext "1" *-- "many" CashReturn
    AppDbContext "1" *-- "many" AuditLog

    %% Entity Relationships
    User "many" --> "1" Role : assigned to
    Role "1" *-- "many" RolePermission : defines
    RolePermission "many" --> "1" Permission : grants

    AdvanceRequest "many" --> "1" User : requested by
    AdvanceRequest "many" --> "0..1" User : approved by
    AdvanceRequest "many" --> "0..1" User : issued by
    AdvanceRequest "1" o-- "many" AdvanceRequest : supplemental advance

    AdvanceRequest "1" *-- "many" Expense : funds
    Expense "many" --> "1" User : recorded by
    Expense "many" --> "0..1" User : reviewed by
    Expense "many" --> "1" ExpenseCategory : classified under
    Expense "1" *-- "0..1" Receipt : has

    ReimbursementClaim "many" --> "1" User : submitted by
    ReimbursementClaim "1" --> "0..1" Expense : relates to
    ReimbursementClaim "many" --> "0..1" User : approved by
    ReimbursementClaim "many" --> "0..1" User : paid by

    AdvanceRequest "1" -- "0..1" Reconciliation : reconciled by
    Reconciliation "many" --> "1" User : performed by
    Reconciliation "1" *-- "many" CashReturn : logs
    CashReturn "many" --> "1" User : confirmed by
    AuditLog "many" --> "1" User : triggered by
