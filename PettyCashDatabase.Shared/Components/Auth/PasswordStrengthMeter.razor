@using PettyCashDatabase.Shared.Auth

<div class="password-meter mt-2" aria-live="polite">
    <div class="d-flex justify-content-between mb-1">
        <small class="auth-muted">Password strength</small>
        <small class="fw-semibold" style="color:@BarColor">@PasswordPolicy.LevelLabel(Score)</small>
    </div>
    <div class="progress" role="progressbar" aria-valuenow="@((Score + 1) * 25)" aria-valuemin="0" aria-valuemax="100">
        <div class="progress-bar" style="width:@((Score + 1) * 25)%; background-color:@BarColor"></div>
    </div>
    @if (Unmet.Count > 0)
    {
        <ul class="rule-list">
            @foreach (var rule in Unmet)
            {
                <li>@rule</li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public string? Password { get; set; }
    [Parameter] public string? Email { get; set; }

    private int Score => PasswordPolicy.Score(Password);
    private IReadOnlyList<string> Unmet => PasswordPolicy.GetUnmetRules(Password, Email);

    private string BarColor => Score switch
    {
        0 => "#b42318",
        1 => "#F2B705",
        2 => "#3d7a5f",
        _ => "#0B3D2E"
    };
}
