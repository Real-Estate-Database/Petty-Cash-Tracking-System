@page "/reset-password"
@* Auth pages are hosted by the app's Interactive Server Routes boundary. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout PettyCashDatabase.Shared.Layout.AuthLayout
@using PettyCashDatabase.Shared.Components.Auth
@using PettyCashDatabase.Shared.DTOs.Auth
@using PettyCashDatabase.Shared.Interfaces
@inject IAuthService AuthService
@inject INotificationService Notifications
@inject NavigationManager Navigation

<PageTitle>Reset password — PettyCash</PageTitle>

<div class="auth-shell">
    @* ── Left side: Form ──────────────────────────────────── *@
    <section class="auth-form-side">
        <div class="auth-form-wrapper">
            <div class="auth-logo">
                <div class="auth-logo-icon">PC</div>
                <span class="auth-logo-text">PettyCash</span>
            </div>

            <h1 class="auth-heading">Reset Password</h1>
            <p class="auth-subtitle">
                Choose a strong new password for your account.
            </p>

            <div class="auth-form">
                @if (string.IsNullOrWhiteSpace(_model.Email) || string.IsNullOrWhiteSpace(_model.Token))
                {
                    <div class="alert alert-danger">This reset link is invalid. Request a new one.</div>
                    <a class="btn btn-accent w-100" href="/forgot-password">Request New Link</a>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="reset-password">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label" for="new-password">New Password *</label>
                            <InputText id="new-password" class="form-control" maxlength="255" type="password"
                                       placeholder="Enter new password"
                                       @bind-Value="_model.NewPassword" @bind-Value:event="oninput" autofocus />
                            <ValidationMessage For="() => _model.NewPassword" />
                            <PasswordStrengthMeter Password="@_model.NewPassword" Email="@_model.Email" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="confirm-password">Confirm Password *</label>
                            <InputText id="confirm-password" class="form-control" maxlength="255" type="password"
                                       placeholder="Confirm new password"
                                       @bind-Value="_model.ConfirmPassword" />
                            <ValidationMessage For="() => _model.ConfirmPassword" />
                        </div>

                        <button class="btn btn-accent w-100" type="submit" disabled="@_busy">
                            @(_busy ? "Saving..." : "Update Password")
                        </button>
                    </EditForm>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger mt-3">@_error</div>
                    }
                }
            </div>

            <div class="auth-footer">
                Copyright &copy; @DateTime.Now.Year PettyCash. All Rights Reserved.
            </div>
        </div>
    </section>

    @* ── Right side: Brand visual ─────────────────────────── *@
    <section class="auth-brand-side">
        <div class="auth-brand-visual">
            <div class="brand-card brand-card-1">
                <div class="brand-card-label">Password Strength</div>
                <div class="brand-card-value">Strong</div>
                <div class="brand-card-accent">✓ Secure</div>
            </div>
            <div class="brand-card brand-card-2">
                <div class="brand-card-label">Token Validity</div>
                <div class="brand-card-value">24 hrs</div>
                <div class="brand-card-accent">One-time use</div>
            </div>
            <div class="brand-card brand-card-3">
                <div class="brand-card-label">Protected By</div>
                <div class="brand-card-value">PBKDF2</div>
                <div class="brand-card-accent">600K iterations</div>
            </div>
        </div>

        <div class="auth-brand-content">
            <div class="auth-brand-badge">PC</div>
            <h2 class="auth-brand-title">
                Almost There!<br />
                <span>Secure Your Account</span>
            </h2>
            <p class="auth-brand-desc">
                Choose a strong password that meets our security requirements
                to protect your financial data.
            </p>
        </div>
    </section>
</div>

@code {
    private readonly ResetPasswordDto _model = new();
    private bool _busy;
    private string? _error;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    protected override void OnParametersSet()
    {
        _model.Email = Email ?? string.Empty;
        _model.Token = Token ?? string.Empty;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await AuthService.ResetPasswordAsync(_model);
            await Notifications.ShowAsync(
                AppNotificationKind.Success,
                "Password updated",
                "Your password was changed securely. Redirecting you to sign in.");
            Navigation.NavigateTo("/login?reset=1");
        }
        catch (Exception)
        {
            _error = "Unable to reset password. The link may be invalid or expired.";
            await Notifications.ShowAsync(AppNotificationKind.Error, "Password update failed", _error);
        }
        finally
        {
            _busy = false;
        }
    }
}
