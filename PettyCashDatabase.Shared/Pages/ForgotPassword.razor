@page "/forgot-password"
@* Auth pages are hosted by the app's Interactive Server Routes boundary. *@
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@layout PettyCashDatabase.Shared.Layout.AuthLayout
@using System.Timers
@using PettyCashDatabase.Shared.DTOs.Auth
@using PettyCashDatabase.Shared.Interfaces
@inject IAuthService AuthService
@implements IDisposable

<PageTitle>Forgot password — PettyCash</PageTitle>

<div class="auth-shell">
    @* ── Left side: Form ──────────────────────────────────── *@
    <section class="auth-form-side">
        <div class="auth-form-wrapper">
            <div class="auth-logo">
                <div class="auth-logo-icon">PC</div>
                <span class="auth-logo-text">PettyCash</span>
            </div>

            <h1 class="auth-heading">Forgot Password</h1>
            <p class="auth-subtitle">
                Reset your password securely. We'll email a one-time link if the account exists.
            </p>

            <div class="auth-form">
                @if (_submitted)
                {
                    <div class="alert alert-success" role="status">
                        If this email exists, a reset link has been sent.
                    </div>
                    <button class="btn btn-outline-secondary w-100" type="button" disabled="@(_countdown > 0 || _busy)" @onclick="ResendAsync">
                        @(_countdown > 0 ? $"Resend in {_countdown}s" : (_busy ? "Sending..." : "Resend email"))
                    </button>
                }
                else
                {
                    <EditForm Model="_model" OnValidSubmit="SubmitAsync" FormName="forgot-password">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label" for="forgot-email">Email Address *</label>
                            <InputText id="forgot-email" class="form-control" maxlength="255" placeholder="Enter your email address" @bind-Value="_model.Email" autofocus />
                            <ValidationMessage For="() => _model.Email" />
                        </div>
                        <button class="btn btn-accent w-100" type="submit" disabled="@_busy">
                            @(_busy ? "Sending..." : "Send Reset Link")
                        </button>
                    </EditForm>
                }

                <div class="auth-links mt-3">
                    <a href="/login">Back to sign in</a>
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger mt-3">@_error</div>
                }
            </div>

            <div class="auth-footer">
                Copyright &copy; @DateTime.Now.Year PettyCash. All Rights Reserved.
            </div>
        </div>
    </section>

    @* ── Right side: Brand visual ─────────────────────────── *@
    <section class="auth-brand-side">
        <div class="auth-brand-visual">
            <div class="brand-card brand-card-1">
                <div class="brand-card-label">Security First</div>
                <div class="brand-card-value">256-bit</div>
                <div class="brand-card-accent">AES Encryption</div>
            </div>
            <div class="brand-card brand-card-2">
                <div class="brand-card-label">Account Recovery</div>
                <div class="brand-card-value">&lt; 2 min</div>
                <div class="brand-card-accent">Average time</div>
            </div>
            <div class="brand-card brand-card-3">
                <div class="brand-card-label">Uptime</div>
                <div class="brand-card-value">99.9%</div>
                <div class="brand-card-accent">✓ Enterprise SLA</div>
            </div>
        </div>

        <div class="auth-brand-content">
            <div class="auth-brand-badge">PC</div>
            <h2 class="auth-brand-title">
                Your Security is<br />
                <span>Our Top Priority</span>
            </h2>
            <p class="auth-brand-desc">
                We use industry-standard encryption and secure token-based recovery
                to keep your account safe.
            </p>
        </div>
    </section>
</div>

@code {
    private readonly ForgotPasswordDto _model = new();
    private bool _busy;
    private bool _submitted;
    private string? _error;
    private int _countdown;
    private Timer? _timer;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await AuthService.ForgotPasswordAsync(_model);
            _submitted = true;
            StartCountdown();
        }
        catch (Exception)
        {
            _error = "Unable to process the request right now.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            await AuthService.ResendResetEmailAsync(new ResendResetEmailDto { Email = _model.Email });
            StartCountdown();
        }
        catch (HttpRequestException)
        {
            _error = "Too many reset requests. Try again later.";
        }
        catch (Exception)
        {
            _error = "Unable to resend right now.";
        }
        finally
        {
            _busy = false;
        }
    }

    private void StartCountdown()
    {
        _countdown = 60;
        _timer?.Dispose();
        _timer = new Timer(1000);
        _timer.Elapsed += (_, _) =>
        {
            if (_countdown <= 0)
            {
                _timer?.Stop();
                return;
            }

            _countdown--;
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    public void Dispose() => _timer?.Dispose();
}
